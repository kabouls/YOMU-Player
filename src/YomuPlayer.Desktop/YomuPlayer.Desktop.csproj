<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>YomuPlayer.Desktop</RootNamespace>
    <AssemblyName>YomuPlayer</AssemblyName>
    <Product>YOMU Player</Product>
    <AssemblyTitle>YOMU Player</AssemblyTitle>
    <Description>YOMU Player - a lightweight YouTube Music desktop client</Description>
    <Company>YOMU Player</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="changelog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ship a pre-registered Google OAuth client with release builds. The file itself is git-ignored. -->
    <Content Include="..\..\google-client.json" Link="google-client.json"
             Condition="Exists('..\..\google-client.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YomuPlayer.Core\YomuPlayer.Core.csproj" />
    <ProjectReference Include="..\YomuPlayer.Audio.Vlc\YomuPlayer.Audio.Vlc.csproj" />
  </ItemGroup>

</Project>
