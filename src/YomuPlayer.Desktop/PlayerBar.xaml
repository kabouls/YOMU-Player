<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YomuPlayer.Desktop.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <Grid x:Name="BarRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="VolumePanel.Visibility" Value="Collapsed" />
                            <Setter Target="TimeText.Visibility" Value="Collapsed" />
                            <Setter Target="ShuffleToggle.Visibility" Value="Collapsed" />
                            <Setter Target="DevicesButton.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Seek bar along the top edge; indeterminate bar while a track is being prepared.
                 The row is tall enough for the slider's thumb: a shorter row clips its top. -->
            <Grid Grid.Row="0" Height="32">
                <ProgressBar x:Name="ResolvingBar" IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Top" />
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0" Margin="12,0" Height="32"
                        VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                        AutomationProperties.AutomationId="PositionSlider"
                        ValueChanged="PositionSlider_ValueChanged">
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                        <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFFFF" />
                        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#00FFFFFF" />
                    </Slider.Resources>
                </Slider>
            </Grid>

            <Grid Grid.Row="1" Padding="16,2,16,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Transport -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Click="PrevButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="44" Height="44">
                        <FontIcon Glyph="&#xE892;" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click"
                            Style="{StaticResource AccentButtonStyle}" Width="48" Height="48" CornerRadius="24"
                            Padding="0" Foreground="White">
                        <Grid>
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" Foreground="White" />
                            <ProgressRing x:Name="PlayRing" Width="22" Height="22" IsActive="False"
                                          Visibility="Collapsed" Foreground="White" />
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="44" Height="44">
                        <FontIcon Glyph="&#xE893;" />
                    </Button>
                    <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Now playing. Clicking it opens the full player page, like YouTube Music. -->
                <Button x:Name="NowPlayingButton" Grid.Column="1" Click="NowPlayingButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Open now playing"
                        AutomationProperties.AutomationId="NowPlayingButton">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Grid Width="52" Height="52">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush x:Name="NowArt" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="ArtScrim" CornerRadius="6" Background="#AA000000" Visibility="Collapsed" />
                            <ProgressRing x:Name="ArtRing" Width="26" Height="26" IsActive="False" Visibility="Collapsed"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock x:Name="NowTitle" Text="Nothing playing" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="NowTitle"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="NowArtist" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="NowArtist"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border x:Name="NowExplicitBadge" Visibility="Collapsed" BorderThickness="1"
                                        BorderBrush="#8A8A8A" CornerRadius="2" Padding="3,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="E" FontSize="9" Foreground="#B8B8B8" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Extras -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="LikeButton" Click="LikeButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="40" Height="44" Visibility="Collapsed" IsEnabled="False"
                            ToolTipService.ToolTip="Like this song"
                            AutomationProperties.AutomationId="LikeButton">
                        <Grid Width="20" Height="20">
                            <FontIcon x:Name="LikeIcon" Glyph="&#xE8E1;" FontSize="16" Foreground="White" Opacity="0.55" />
                            <FontIcon x:Name="LikeFilledIcon" Glyph="&#xF3BF;" FontSize="16"
                                      Foreground="White" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="DislikeButton" Click="DislikeButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="40" Height="44" Visibility="Collapsed" IsEnabled="False"
                            ToolTipService.ToolTip="Dislike this song"
                            AutomationProperties.AutomationId="DislikeButton">
                        <Grid Width="20" Height="20">
                            <FontIcon x:Name="DislikeIcon" Glyph="&#xE8E0;" FontSize="16" Foreground="White"
                                      Opacity="0.55" />
                            <FontIcon x:Name="DislikeFilledIcon" Glyph="&#xF3C0;" FontSize="16"
                                      Foreground="White" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="DevicesButton" Click="DevicesButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="44" Height="44" ToolTipService.ToolTip="Playback devices"
                            AutomationProperties.AutomationId="DevicesButton">
                        <FontIcon Glyph="&#xE772;" />
                    </Button>
                    <StackPanel x:Name="VolumePanel" Orientation="Horizontal" Spacing="2" Margin="4,0,8,0"
                                VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Click="MuteButton_Click" Style="{StaticResource SubtleButtonStyle}"
                                Width="40" Height="40" VerticalAlignment="Center" ToolTipService.ToolTip="Mute">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="100" Height="32" VerticalAlignment="Center"
                                Minimum="0" Maximum="100" Value="70"
                                ToolTipService.ToolTip="Scroll to adjust volume"
                                AutomationProperties.AutomationId="VolumeSlider"
                                ValueChanged="VolumeSlider_ValueChanged">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#00FFFFFF" />
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>
                    <ToggleButton x:Name="ShuffleToggle" Click="ShuffleToggle_Click" Width="44" Height="44"
                                  MinWidth="0" Padding="0" Background="Transparent" BorderThickness="0"
                                  ToolTipService.ToolTip="Shuffle">
                        <FontIcon Glyph="&#xE8B1;" />
                    </ToggleButton>
                    <Button x:Name="RepeatButton" Click="RepeatButton_Click" Style="{StaticResource SubtleButtonStyle}"
                            Width="44" Height="44">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" Opacity="0.5" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}" Width="44" Height="44"
                            AutomationProperties.AutomationId="SettingsButton">
                        <FontIcon Glyph="&#xE713;" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10" Width="240">
                                    <TextBlock Text="Audio quality" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <RadioButtons x:Name="QualityRadios" SelectedIndex="1"
                                                  SelectionChanged="QualityRadios_SelectionChanged">
                                        <x:String>High (opus, ~130 kbps)</x:String>
                                        <x:String>Balanced (opus, ~70 kbps)</x:String>
                                        <x:String>Data saver (~50 kbps)</x:String>
                                    </RadioButtons>
                                    <ToggleSwitch x:Name="AutoplayToggle" Header="Autoplay similar songs" IsOn="True"
                                                  Toggled="AutoplayToggle_Toggled">
                                        <ToggleSwitch.Resources>
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
                                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
                                        </ToggleSwitch.Resources>
                                    </ToggleSwitch>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Single open/close control for the full player page, at the far right. -->
                    <Button x:Name="TogglePlayerButton" Click="TogglePlayerButton_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="44" Height="44"
                            ToolTipService.ToolTip="Open player"
                            AutomationProperties.AutomationId="TogglePlayerButton">
                        <FontIcon x:Name="TogglePlayerIcon" Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
