<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YomuPlayer.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YomuPlayer.Desktop"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Must be instantiated (not Source=) so its x:Bind templates are connected -->
                <local:Templates />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pitch-black base; every other surface is a step lighter -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#070707" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#111111" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#070707" />
                    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#141414" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#181818" />
                    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#121212" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <!-- white text on the red accent -->
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#87FFFFFF" />
                    <!-- AccentButtonStyle resolves its Foreground through these keys (not TextOnAccent...), so a
                         black glyph could appear on the red play buttons. Force white in every button state. -->
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#87FFFFFF" />
                    <!-- white slider thumbs read better on the red fill -->
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#000000" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#070707" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#181818" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#000000" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- YouTube Music red replaces the Windows accent everywhere (buttons, sliders, selection, focus) -->
            <Color x:Key="SystemAccentColor">#FFFF0033</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFF1F4B</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFF0033</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFF5A78</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE6002E</Color>
            <Color x:Key="SystemAccentColorDark2">#FFCC0029</Color>
            <Color x:Key="SystemAccentColorDark3">#FFB30024</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
