<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YomuPlayer.Desktop.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YomuPlayer.Desktop">

    <Grid>
        <ListView x:Name="TrackList" ItemsSource="{x:Bind Tracks}" ItemTemplate="{StaticResource TrackRowTemplate}"
                  SelectionMode="None" IsItemClickEnabled="False" Padding="28,8,28,16">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <Grid Padding="0,8,0,20" ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="224" Height="234" VerticalAlignment="Top">
                        <Border x:Name="StackBack1" Height="5" Margin="28,0,28,0" VerticalAlignment="Top"
                                CornerRadius="3" Background="#2B2B2B" Visibility="Collapsed" />
                        <Border x:Name="StackBack2" Height="5" Margin="14,7,14,0" VerticalAlignment="Top"
                                CornerRadius="3" Background="#454545" Visibility="Collapsed" />
                        <Border Width="224" Height="224" VerticalAlignment="Bottom" CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                            <Grid x:Name="CollageGrid" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Background="#181818">
                                    <Image x:Name="Collage0" Stretch="UniformToFill" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#181818">
                                    <Image x:Name="Collage1" Stretch="UniformToFill" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="#181818">
                                    <Image x:Name="Collage2" Stretch="UniformToFill" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#181818">
                                    <Image x:Name="Collage3" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="8">
                        <Border x:Name="KindPill" HorizontalAlignment="Left" CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="KindText" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                       Foreground="White" />
                        </Border>
                        <TextBlock x:Name="TitleText" Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="ArtistLinksRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="ArtistLinksLabel" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="ArtistLinks">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ArtistLinkVM">
                                        <HyperlinkButton Content="{x:Bind Label}" Command="{x:Bind OpenCommand}"
                                                         Padding="0" MinHeight="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock x:Name="StatsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button x:Name="PlayAllButton" Click="PlayAllButton_Click" IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}" Padding="20,10" Foreground="White">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                                    <TextBlock Text="Play" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" Click="ShuffleButton_Click" IsEnabled="False" Padding="20,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeletePlaylistButton" Click="DeletePlaylist_Click"
                                    Visibility="Collapsed" Padding="14,10"
                                    AutomationProperties.AutomationId="DeletePlaylistButton"
                                    ToolTipService.ToolTip="Delete this playlist">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Delete" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ListView.Header>

            <ListView.Footer>
                <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMore_Click"
                        HorizontalAlignment="Center" Margin="0,16,0,28" Visibility="Collapsed" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
