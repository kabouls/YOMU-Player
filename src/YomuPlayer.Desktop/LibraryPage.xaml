<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YomuPlayer.Desktop.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,8,28,24" Spacing="18" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Signed out -->
            <StackPanel x:Name="SignedOutPanel" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock TextWrapping="Wrap"
                           Text="Sign in with your Google account to see your liked songs, playlists and recommendations."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="SignInButton" Click="SignInButton_Click"
                            Style="{StaticResource AccentButtonStyle}" Foreground="White" Padding="18,10"
                            AutomationProperties.AutomationId="GoogleSignInButton">
                        <TextBlock Text="Sign in with Google" Foreground="White" />
                    </Button>
                    <ProgressRing x:Name="SignInBusy" Width="24" Height="24" IsActive="False"
                                  Visibility="Collapsed" />
                    <Button x:Name="CancelSignInButton" Content="Cancel" Click="CancelSignIn_Click"
                            Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="SignInStatus" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="How sign-in works" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Press the button: your default browser opens Google's page, reuses the session you are already signed in to, and returns here. No password is typed into this app. Release builds include the app's Google client, so no Google Cloud setup is needed; source builds ask for one once." />
                    </StackPanel>
                </Border>

                <HyperlinkButton x:Name="ResetClientLink" Visibility="Collapsed"
                                 Content="Use different Google app credentials (advanced)"
                                 Click="ResetClient_Click" Padding="0" MinHeight="0" />
            </StackPanel>

            <!-- Signed in -->
            <StackPanel x:Name="SignedInPanel" Spacing="16" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <PersonPicture x:Name="Avatar" Width="56" Height="56" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="NameText" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EmailText" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="LikedSongsButton" Click="LikedSongs_Click"
                            Style="{StaticResource AccentButtonStyle}" Foreground="White" Padding="18,10">
                        <TextBlock Text="Liked songs" Foreground="White" />
                    </Button>
                    <Button Content="Sign out" Click="SignOut_Click" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Your playlists" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Grid.Column="1" Content="New playlist" Click="NewPlaylist_Click" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind Playlists}" ItemTemplate="{StaticResource CardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="190" MinItemHeight="250"
                                           MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock x:Name="PlaylistsEmpty" Text="No playlists yet. Create one above."
                           Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnSpacing="12" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recently played" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Grid.Column="1" Content="Clear" Click="ClearHistory_Click" />
                </Grid>
                <TextBlock Text="Local to this PC — not synced with your YouTube account history."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
                <ItemsRepeater ItemsSource="{x:Bind HistoryRows}" ItemTemplate="{StaticResource ListItemTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="360" MinItemHeight="64"
                                           MinRowSpacing="4" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock x:Name="HistoryEmpty" Text="Nothing played yet."
                           Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock TextWrapping="Wrap" MaxWidth="640"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Your library is loaded from your Google account. Playlists open in the normal browse view; liked songs open as a collection you can play or shuffle." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
