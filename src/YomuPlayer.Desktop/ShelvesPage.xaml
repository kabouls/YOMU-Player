<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YomuPlayer.Desktop.ShelvesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YomuPlayer.Desktop">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,8,28,24" Spacing="8">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />

                <StackPanel x:Name="RegionPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed"
                            VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="Region" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="RegionBox" Width="280" SelectionChanged="RegionBox_SelectionChanged" />
                </StackPanel>

                <TextBlock x:Name="EmptyText" Text="Nothing to show here." Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsControl ItemsSource="{x:Bind Shelves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ShelfVM">
                            <StackPanel Spacing="6" Margin="0,12,0,8">
                                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind TitleVisibility}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                                <local:ShelfScroller Visibility="{x:Bind CardsVisibility}"
                                                     ItemsSource="{x:Bind Items}"
                                                     ItemTemplate="{StaticResource CardTemplate}" />

                                <!-- Rows must be measured against the page width, not inside the horizontal scroller. -->
                                <ItemsRepeater ItemsSource="{x:Bind Items}"
                                               ItemTemplate="{StaticResource QuickRowTemplate}"
                                               Visibility="{x:Bind ListVisibility}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="340"
                                                           MinItemHeight="64" MinRowSpacing="4" MinColumnSpacing="12"
                                                           ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <ItemsRepeater ItemsSource="{x:Bind Items}"
                                               ItemTemplate="{StaticResource ChipTemplate}"
                                               Visibility="{x:Bind ChipsVisibility}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="200" MinItemHeight="48"
                                                           MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="Busy" Width="40" Height="40" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
