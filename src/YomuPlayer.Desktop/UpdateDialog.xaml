<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YomuPlayer.Desktop.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Update available"
    PrimaryButtonText="Download &amp; install"
    CloseButtonText="Later"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="440" MaxWidth="560">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="#FFE8E8E8" />
            <TextBlock x:Name="VersionText" Style="{ThemeResource SubtitleTextBlockStyle}" />
        </StackPanel>
        <TextBlock x:Name="DateText" Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
        <ProgressBar x:Name="Progress" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
