<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YomuPlayer.Desktop.LinkConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid ColumnSpacing="18" MinWidth="440">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ArtBorder" Width="112" Height="112" CornerRadius="10" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="Found in your pasted link" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="KindPill" HorizontalAlignment="Left" CornerRadius="4" Padding="8,3">
                <TextBlock x:Name="KindText" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                           Foreground="White" />
            </Border>
            <TextBlock x:Name="TitleText" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</ContentDialog>
