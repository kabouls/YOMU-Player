<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YomuPlayer.Desktop.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YomuPlayer.Desktop">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,8,28,24" Spacing="8">

                <!-- Header -->
                <Grid ColumnSpacing="28" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="188" Height="188" CornerRadius="94" VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="8,3" Background="#EE1F9D55">
                            <TextBlock Text="ARTIST" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                                       Foreground="White" />
                        </Border>
                        <TextBlock x:Name="NameText" Style="{ThemeResource TitleLargeTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AboutText" MaxLines="3" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button x:Name="PlayButton" Click="PlayButton_Click" IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}" Padding="20,10" Foreground="White">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" />
                                    <TextBlock Text="Play" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShuffleButton" Click="ShuffleButton_Click" IsEnabled="False" Padding="20,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                                    <TextBlock Text="Shuffle" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="EmptyText" Text="Nothing to show for this artist." Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Songs, albums, singles, videos, similar artists: whatever the page offers, in its own order -->
                <ItemsControl ItemsSource="{x:Bind Shelves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ShelfVM">
                            <StackPanel Spacing="6" Margin="0,12,0,8">
                                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind TitleVisibility}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                                <local:ShelfScroller Visibility="{x:Bind CardsVisibility}"
                                                     ItemsSource="{x:Bind Items}"
                                                     ItemTemplate="{StaticResource CardTemplate}" />

                                <ItemsRepeater ItemsSource="{x:Bind Items}"
                                               ItemTemplate="{StaticResource QuickRowTemplate}"
                                               Visibility="{x:Bind ListVisibility}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MinItemWidth="340"
                                                           MinItemHeight="64" MinRowSpacing="4" MinColumnSpacing="12"
                                                           ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
