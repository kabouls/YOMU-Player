<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YomuPlayer.Desktop.GoogleSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Google sign-in setup"
    PrimaryButtonText="Continue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Spacing="12">
            <TextBlock TextWrapping="Wrap"
                       Text="Google requires every app to have its own OAuth client. This is a one-time app registration (about 10 minutes), not your Google password. Once it is done, signing in is one click in your browser." />

            <TextBlock TextWrapping="Wrap"
                       Text="If this build was shared with you, it may already include a client. You only need these steps if the app asks for them." />

            <StackPanel Spacing="6">
                <TextBlock Text="1. Create or select a project in Google Cloud Console." TextWrapping="Wrap" />
                <TextBlock Text="2. Enable the YouTube Data API v3 for that project (free quota; no payment needed)." TextWrapping="Wrap" />
                <TextBlock Text="3. Open the OAuth consent screen. Google now calls it Google Auth Platform: choose External, fill in the app name and support email, add the scope https://www.googleapis.com/auth/youtube under Data Access, then add your Google account under Test users." TextWrapping="Wrap" />
                <TextBlock Text="4. Create credentials -> OAuth client ID -> Application type: Desktop app." TextWrapping="Wrap" />
                <TextBlock Text="5. Paste the client ID and client secret below." TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Older Google accounts show this page as 'OAuth consent screen / Scopes / Test users' instead of 'Google Auth Platform / Data Access / Audience'. Both paths work." />

            <StackPanel Orientation="Horizontal" Spacing="14">
                <HyperlinkButton Content="Open Google Cloud Console" Click="Console_Click" Padding="0" MinHeight="0" />
                <HyperlinkButton Content="Enable YouTube Data API v3" Click="Api_Click" Padding="0" MinHeight="0" />
            </StackPanel>

            <TextBox x:Name="ClientIdBox" Header="OAuth client ID"
                     PlaceholderText="1234567890-abc.apps.googleusercontent.com" />
            <PasswordBox x:Name="ClientSecretBox" Header="OAuth client secret"
                         PasswordRevealMode="Peek" />

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The client secret is stored encrypted for your Windows account. Your Google password never passes through this app: sign-in happens in your default browser. While the OAuth app is in Testing mode, only Test users can sign in and Google may ask you to sign in again after 7 days. Keep it in Testing until the app is ready for public distribution." />

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFE8E8E8" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
