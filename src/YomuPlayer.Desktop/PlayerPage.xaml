<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YomuPlayer.Desktop.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YomuPlayer.Desktop"
    Background="#000000">

    <Page.Resources>
        <!-- Compact, clickable queue row: status on the left, title/artist stacked, no artwork. -->
        <DataTemplate x:Key="QueueRowTemplate" x:DataType="local:QueueRowVM">
            <Button Command="{x:Bind PlayCommand}" Background="{x:Bind RowBackground}" BorderThickness="0"
                    Padding="6,4" CornerRadius="6" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" ContextRequested="QueueRow_ContextRequested"
                    AutomationProperties.Name="{x:Bind Title}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="{x:Bind StatusGlyph}" FontSize="11"
                              Opacity="{x:Bind StatusOpacity}" VerticalAlignment="Center"
                              Foreground="#F2F2F2" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Title}" Foreground="#F2F2F2" MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Visibility="{x:Bind ExplicitVisibility}" BorderThickness="1"
                                    BorderBrush="#8A8A8A" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                                <TextBlock Text="E" FontSize="9" Foreground="#B8B8B8" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{x:Bind Duration}" VerticalAlignment="Center" MinWidth="38"
                               TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Layout" Padding="24,4,24,6" Background="#000000" SizeChanged="Layout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*" />
            <RowDefinition x:Name="BottomRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Left: the artwork fills the panel, centered on both axes. No metadata; the bar has it. -->
        <Grid x:Name="LeftPane" Grid.Row="0" Grid.Column="0">
            <Grid x:Name="ArtHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="0">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="ArtPlaceholder" CornerRadius="0" Background="#141414">
                    <FontIcon Glyph="&#xE8D6;" FontSize="56" Opacity="0.25" />
                </Border>
            </Grid>
        </Grid>

        <!-- Right: Up next / Lyrics, with the queue source and Save -->
        <Grid x:Name="RightPane" Grid.Row="0" Grid.Column="1" RowSpacing="8" MinWidth="340">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBar.Resources>
                    <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SelectorBarItemForeground" Color="#A7A7A7" />
                </SelectorBar.Resources>
                <SelectorBarItem x:Name="QueueTab" Text="UP NEXT" IsSelected="True"
                                 AutomationProperties.AutomationId="QueueTab" />
                <SelectorBarItem x:Name="LyricsTab" Text="LYRICS"
                                 AutomationProperties.AutomationId="LyricsTab" />
            </SelectorBar>

            <Grid Grid.Row="1">
                <!-- Up next -->
                <Grid x:Name="QueuePanel" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Playing from" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="QueueSourceText" Text="This queue" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </StackPanel>

                        <Button x:Name="SaveQueueButton" Grid.Column="1" Click="SaveQueue_Click"
                                Background="#FFFFFF" Foreground="#000000" BorderThickness="0"
                                CornerRadius="16" Padding="12,5" MinWidth="0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Save this queue to a playlist"
                                AutomationProperties.AutomationId="SaveQueueButton">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="Black" />
                                <TextBlock Text="Save" Foreground="Black" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" x:Name="QueueList" ItemsSource="{x:Bind QueueRows}"
                              ItemTemplate="{StaticResource QueueRowTemplate}"
                              SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock x:Name="QueueEmpty" Grid.Row="1" Visibility="Collapsed"
                               Text="Nothing queued. Play a song and its radio will fill this list."
                               TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- Lyrics -->
                <Grid x:Name="LyricsPanel" Visibility="Collapsed" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Lyrics" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LyricsFooter" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}" MaxWidth="280"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ScrollViewer x:Name="LyricsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed" Padding="0,4,12,24">
                        <TextBlock x:Name="LyricsBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontSize="18" LineHeight="30" LineStackingStrategy="BlockLineHeight"
                                   Foreground="#E8E8E8" MaxWidth="620" HorizontalAlignment="Left" />
                    </ScrollViewer>

                    <StackPanel x:Name="LyricsMessage" Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                        <TextBlock x:Name="LyricsMessageText" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="LyricsSearchButton" Content="Search the web" Visibility="Collapsed"
                                Click="LyricsSearchButton_Click" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ProgressRing x:Name="LyricsBusy" Grid.Row="1" Width="36" Height="36" IsActive="False"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
